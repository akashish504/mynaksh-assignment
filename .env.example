# Copy to .env and fill in real values. Never commit .env.
# For local development with docker-compose.dev.yml the database values below are
# overridden by the compose file, so they only matter in production.

# --- Postgres (Neon) ---
# Pooled connection string: used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require
# Direct connection string: used by Alembic migrations.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

# --- Neo4j (AuraDB) ---
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=YOUR_NEO4J_USER
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# --- Auth ---
# Long random string used to sign login tokens, e.g. from: openssl rand -hex 32
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRY_MINUTES=10080

# --- HTTP ---
# Public hostname of the API. Caddy serves HTTPS for it (production only).
API_DOMAIN=YOUR_API_HOSTNAME
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# --- Feature flags ---
CLARIFY_ENABLED=false
USE_EMBEDDINGS=false
CLASSIFIER=jev
MEMORY_GATE_ENABLED=true

# --- Tuning ---
HISTORY_WINDOW=6
TOP_K_MEMORIES=5
ROUTER_MIN_CONFIDENCE=0.7
AREA_THRESHOLD=0.5
MEMORY_GATE_THRESHOLD=0.5
RECENCY_HALF_LIFE_DAYS=90

# --- Models ---
PRIMARY_MODEL=
FALLBACK_MODEL=
JEV_MODEL=jev-1.13.0
